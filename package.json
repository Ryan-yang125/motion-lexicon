  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "^1.0.0-beta.26",
