{
  "name": "motion-lexicon",
  "version": "2.0.1",
  "description": "An open product-motion system with Motion Packs, Motion Primitives, and the Motion Director Agent Skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryan-yang125/motion-lexicon.git"
  },
  "homepage": "https://motion-lexicon.pages.dev",
  "bugs": {
    "url": "https://github.com/Ryan-yang125/motion-lexicon/issues"
  },
  "keywords": [
    "motion-design",
    "animation",
    "css-animation",
    "motion",
    "motion-director",
    "agent-skill",
    "reduced-motion",
    "ui"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "build": "tsc -b && vite build && tsx --tsconfig tsconfig.app.json scripts/prerender.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "vocabulary:check": "tsx scripts/check-vocabulary.ts",
    "motion-grammar:check": "tsx scripts/check-motion-grammar.ts",
    "skill:check": "node scripts/check-motion-director-skill.mjs",
    "seo:check": "tsx scripts/check-seo.ts",
    "motion:check": "tsx scripts/check-motion.ts",
    "assets:brand": "tsx scripts/generate-brand-assets.ts",
    "artifacts:generate": "tsx scripts/generate-public-artifacts.ts",
    "artifacts:check": "tsx scripts/check-public-artifacts.ts",
    "a11y:check": "tsx scripts/check-a11y.ts",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "crawl:dist": "tsx scripts/crawl-dist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:lab": "playwright test --config playwright.lab.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "@radix-ui/react-slider": "^1.4.7",
    "motion": "^12.43.0"
  }
}
